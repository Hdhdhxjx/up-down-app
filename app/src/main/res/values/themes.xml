<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UpDown" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/color_accent</item>
        <item name="colorOnPrimary">@color/color_accent_text_on</item>
        <item name="colorSecondary">@color/v5_accent_2</item>
        <item name="colorSurface">@color/color_bg_primary</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="android:colorBackground">@color/color_bg_primary</item>
        <item name="android:statusBarColor">@color/color_bg_primary</item>
        <item name="android:navigationBarColor">@color/color_bg_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="Theme.UpDown.Transparent" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@color/color_transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Text.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Text.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Sub" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>
</resources>
